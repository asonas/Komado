<Window x:Class="MangaViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Komado" Icon="Assets/app-icon.ico" Width="1200" Height="850" MinWidth="800" MinHeight="400"
    WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource CanvasBrush}"
    Foreground="{StaticResource TextBrush}" FontFamily="Noto Sans JP, Yu Gothic UI" FontSize="12"
    AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop" DragLeave="Window_DragLeave"
    PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Deactivated="Window_Deactivated"
    Closing="Window_Closing" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="{StaticResource SurfaceBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
                <Image Source="Assets/app-icon.ico" Width="16" Height="16" Margin="0,0,10,0" />
                <TextBlock Text="Komado" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="ReaderButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="{StaticResource CanvasBrush}" CornerRadius="4" Height="30" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Margin="3,2">
                        <Button x:Name="AutoButton" Content="自動" Width="54" Click="Auto_Click" AutomationProperties.Name="画像の縦横比で自動表示" />
                        <Button x:Name="SingleButton" Content="単ページ" Width="70" Click="Single_Click" AutomationProperties.Name="単ページ" />
                        <Button x:Name="FacingButton" Content="見開き" Width="76" Click="Facing_Click" AutomationProperties.Name="見開き" />
                    </StackPanel>
                </Border>
                <Button x:Name="FitButton" Height="30" Margin="0,0,12,0" Click="Fit_Click" ToolTip="ページ全体を画面に合わせる">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="画面に合わせる" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" /><Image Source="Assets/down.png" Width="14" Height="14" Margin="8,0,0,0" /></StackPanel>
                </Button>
                <Button x:Name="DirectionButton" Content="左で次へ" Width="96" Height="30" Margin="0,0,12,0" Background="{StaticResource RaisedBrush}" Click="Direction_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="DirectionMenu" Placement="Bottom" MinWidth="220">
                            <MenuItem x:Name="LeftDirection" Header="左で次へ" IsCheckable="True" Click="LeftDirection_Click" />
                            <MenuItem x:Name="RightDirection" Header="右で次へ" IsCheckable="True" Click="RightDirection_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="FullscreenButton" Width="32" Height="30" Padding="0" Margin="0,0,12,0" Click="Fullscreen_Click" ToolTip="全画面 (F11)" AutomationProperties.Name="全画面">
                    <Image Source="Assets/fullscreen.png" Width="20" Height="20" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="46" Padding="0" Click="Minimize_Click" AutomationProperties.Name="最小化"><Image Source="Assets/minimize.png" Width="14" Height="14" /></Button>
                <Button Width="46" Padding="0" Click="Maximize_Click" AutomationProperties.Name="最大化"><Image Source="Assets/maximize.png" Width="14" Height="14" /></Button>
                <Button Width="46" Padding="0" Click="Close_Click" AutomationProperties.Name="閉じる"><Image Source="Assets/close.png" Width="14" Height="14" /></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="ReadingArea" Background="{StaticResource CanvasBrush}" ClipToBounds="True"
              MouseLeftButtonUp="ReadingArea_Click" PreviewMouseWheel="ReadingArea_Wheel" SizeChanged="ReadingArea_SizeChanged">
            <StackPanel x:Name="Pages" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image x:Name="LeftPage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <Image x:Name="RightPage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>
            <ScrollViewer x:Name="EmptyState" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                <StackPanel x:Name="RecentSection" Visibility="Collapsed" Margin="24">
                    <TextBlock Text="最近開いたファイル" FontSize="14" FontWeight="Medium" Margin="8,0,0,12" />
                    <ItemsControl x:Name="RecentItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="RecentFileButton" Width="192" Margin="8,0,8,16" Padding="8" HorizontalContentAlignment="Stretch"
                                        Click="RecentFile_Click" Tag="{Binding FullPath}" ToolTip="{Binding FullPath}">
                                    <StackPanel>
                                        <Border Width="176" Height="176" Background="{StaticResource SurfaceBrush}" CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="Assets/book.png" Width="32" Height="32" />
                                                <Image x:Name="RecentThumbnail" Stretch="Uniform" Loaded="RecentThumbnail_Loaded" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="SeekBox" Visibility="Collapsed" MaxWidth="640" Height="56" Margin="24,0,24,24" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="#383d40" BorderThickness="1" Padding="20,0"
                    MouseLeftButtonUp="Overlay_Click" PreviewMouseWheel="Overlay_Wheel">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.28" /></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="Assets/grid.png" Width="18" Height="18" Margin="0,0,16,0" />
                    <TextBlock x:Name="PageNumber" Grid.Column="1" Text="0 / 0" VerticalAlignment="Center" FontSize="13" Margin="0,0,16,0" />
                    <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" Value="0" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                            IsMoveToPointEnabled="True" IsDirectionReversed="True" ValueChanged="Seek_ValueChanged" AutomationProperties.Name="ページ位置" />
                </Grid>
            </Border>
            <Border x:Name="ErrorBox" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" MaxWidth="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonUp="Overlay_Click">
                <StackPanel><TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="14" /><Button Content="閉じる" Margin="0,16,0,0" HorizontalAlignment="Right" Click="DismissError_Click" /></StackPanel>
            </Border>
            <TextBlock x:Name="LoadingText" Text="読み込み中…" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" IsHitTestVisible="False" />
        </Grid>
        <Border x:Name="DropHint" Grid.RowSpan="2" Visibility="Collapsed" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" Background="#40141618" IsHitTestVisible="False">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="28,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ドロップして開く" Foreground="{StaticResource AccentBrush}" FontSize="20" />
            </Border>
        </Border>
    </Grid>
</Window>
